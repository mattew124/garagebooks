        "multi": false,
        "options": [],
        "regex": "",
        "query": "SELECT k.id AS __value, k.name || CASE WHEN k.sold_at IS NOT NULL THEN ' (sold)' ELSE '' END AS __text FROM garagebooks.car k WHERE k.kind <> 'BEV' OR EXISTS (SELECT 1 FROM garagebooks.fuel_fill f WHERE f.car_id = k.id) ORDER BY k.id;",
        "definition": "SELECT k.id AS __value, k.name || CASE WHEN k.sold_at IS NOT NULL THEN ' (sold)' ELSE '' END AS __text FROM garagebooks.car k WHERE k.kind <> 'BEV' OR EXISTS (SELECT 1 FROM garagebooks.fuel_fill f WHERE f.car_id = k.id) ORDER BY k.id;",
