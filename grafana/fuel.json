          "rawQuery": true,
          "rawSql": "SELECT f.occurred_at AS \"Date\", e.vendor AS \"Vendor\", f.litres AS \"Litres\", f.amount AS \"Amount\", f.price_per_litre AS \"Price per litre\",\n       f.odometer_km AS \"Odometer\", f.distance_km AS \"Distance since last fuel-up\", f.l_per_100km AS \"L/100 km\",\n       CASE WHEN NOT f.full_tank THEN 'Partial fill' ELSE 'Full tank' END AS \"Fill\",\n       CASE WHEN f.missed_fill THEN 'Fuel-up missed before this' END AS \"Note\"\nFROM garagebooks.fuel_fill f JOIN garagebooks.expense e ON e.id = f.id\nWHERE f.car_id = $car_id AND $__timeFilter(f.occurred_at)\nORDER BY f.occurred_at DESC, f.id DESC",
